# Local Dominate — environment variables (NAMES ONLY, no real values).
# Copy to .env and fill in from the relevant dashboard. Never commit .env itself (already gitignored).
# See docs/ENVIRONMENT_VARIABLE_MATRIX.md for what each one is, where it's used, and its migration status.

# --- Frontend (Vite, VITE_-prefixed = bundled into the client, never secret) ---
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Edge Function secrets (server-side only — set via `supabase secrets set`, never in this file) ---
# RESEND_API_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY=
# INTERNAL_API_SECRET=
# LOVABLE_API_KEY=              # being removed — see docs/AI_DEPENDENCY_REPLACEMENT_PLAN.md
# AI_PROVIDER_API_KEY=          # proposed replacement, not yet in use
# AI_PROVIDER_BASE_URL=         # proposed replacement, not yet in use
# AI_PROVIDER_MODEL=            # proposed replacement, not yet in use
